#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    zephyr,user {
        io-channels = <&adc 7>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios
            = <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* D6 / P1.00 */
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* D7 / P0.11 */
            , <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* D8 / P1.04 */
            , <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* D9 / P1.06 */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
        >;
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN7>; /* D21 / P0.31 / AIN7 */
        zephyr,resolution = <12>;
    };
};
